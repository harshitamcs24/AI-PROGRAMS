def is_variable(x):
    """Checks if x is a variable (a lowercase string)."""
    return isinstance(x, str) and x[0].islower()

def is_compound(x):
    """Checks if x is a compound expression (a tuple)."""
    return isinstance(x, tuple) and len(x) > 0

def occur_check(var, x, theta):
    """Prevents infinite loops by checking if var occurs inside x."""
    if var == x:
        return True
    elif is_variable(x) and x in theta:
        return occur_check(var, theta[x], theta)
    elif is_compound(x):
        return any(occur_check(var, arg, theta) for arg in x[1:])
    return False

def unify_var(var, x, theta):
    """Handles unification when one of the expressions is a variable."""
    if var in theta:
        return unify(theta[var], x, theta)
    elif is_variable(x) and x in theta:
        return unify(var, theta[x], theta)
    elif occur_check(var, x, theta):
        return None  # Failure due to occur check
    else:
        theta[var] = x
        return theta

def unify(x, y, theta=None):
    """Main recursive unification function."""
    if theta is None:
        theta = {}
    
    if theta is None:
        return None
    elif x == y:
        return theta
    elif is_variable(x):
        return unify_var(x, y, theta)
    elif is_variable(y):
        return unify_var(y, x, theta)
    elif is_compound(x) and is_compound(y):
        # Check if predicate/function names and arity (number of args) match
        if x[0] != y[0] or len(x) != len(y):
            return None
        # Recursively unify each argument pair
        for arg_x, arg_y in zip(x[1:], y[1:]):
            theta = unify(arg_x, arg_y, theta)
            if theta is None:
                return None
        return theta
    else:
        return None  # Failure (mismatching constants or types)

# --- Example Usage ---

# Example 1: P(x, f(y)) and P(A, f(B))
expr1 = ("P", "x", ("f", "y"))
expr2 = ("P", "A", ("f", "B"))
print("Example 1 MGU:", unify(expr1, expr2))

# Example 2: P(x, x) and P(y, f(y)) -> Fails occur check
expr3 = ("P", "x", "x")
expr4 = ("P", "y", ("f", "y"))
print("Example 2 MGU:", unify(expr3, expr4))

# Example 3: Knows(John, x) and Knows(y, Mother(y))
expr5 = ("Knows", "John", "x")
expr6 = ("Knows", "y", ("Mother", "y"))
print("Example 3 MGU:", unify(expr5, expr6))
